# ---------------------------------------------------------------------------
# LLM Provider Configuration (via LiteLLM)
# ---------------------------------------------------------------------------
# Model string tells LiteLLM which provider + model to use.
# Examples:
#   ollama/llama3.2                    — Local Ollama (default, no API key needed)
#   ollama/mistral                     — Local Ollama with Mistral
#   ollama/qwen2.5                     — Local Ollama with Qwen
#   anthropic/claude-sonnet-4-20250514 — Anthropic Claude (needs ANTHROPIC_API_KEY)
#   gpt-4o                             — OpenAI (needs OPENAI_API_KEY)
LLM_MODEL=ollama/qwen2:7b

# Ollama API base URL (only used when LLM_MODEL starts with "ollama/")
LLM_API_BASE=http://localhost:11434

# Optional: API keys for cloud providers (not needed for Ollama)
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# AIRS (Prisma AI Runtime Security) Configuration
# ---------------------------------------------------------------------------
# AIRS API Key (from SCM > AI Security > API Applications)
PANW_PRISMA_AIRS_API_KEY=your-airs-api-key-here

# AIRS Security Profile Name (from SCM > AI Security > Security Profiles)
PANW_PRISMA_AIRS_PROFILE_NAME=your-profile-name

# AIRS API Base URL (default: production endpoint)
AIRS_API_BASE=https://service.api.aisecurity.paloaltonetworks.com
